# API runtime defaults. Environment variables passed by the deployment override these.
TILE_ENDPOINT=https://wxs.ign.fr/ortho/geoportail/wmts?layer=ORTHOIMAGERY.ORTHOPHOTOS&style=normal&tilematrixset=PM&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/jpeg&TileMatrix={z}&TileCol={x}&TileRow={y}
TILE_ZOOM=18
MAX_SEARCH_TILES=50
MODEL_PATH=models/model.onnx
API_HOST=0.0.0.0
API_PORT=8080
API_TITLE=detectorLitter
API_VERSION=0.0.0
API_SUMMARY=Waste detection service from photos or satellite images
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9090
DETECTION_DEFAULT_CONFIDENCE=60
DETECTION_NMS_SCORE_THRESHOLD=0.25
DETECTION_NMS_IOU_THRESHOLD=0.6
