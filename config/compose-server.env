# The API downloads the same public orthophotos the map displays.
# tests/data/tiles is an offline cache for fixtures, not the live map.
TILE_ENDPOINT=https://data.geopf.fr/wmts?layer=ORTHOIMAGERY.ORTHOPHOTOS&style=normal&tilematrixset=PM&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/jpeg&TileMatrix={z}&TileCol={x}&TileRow={y}
