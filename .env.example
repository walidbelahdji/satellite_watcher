# Copy this file to .env to override the tracked config/server.env and config/demo.env defaults.
TILE_ENDPOINT=https://data.geopf.fr/wmts?layer=ORTHOIMAGERY.ORTHOPHOTOS&style=normal&tilematrixset=PM&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/jpeg&TileMatrix={z}&TileCol={x}&TileRow={y}
TILE_ZOOM=18
MAX_SEARCH_TILES=500
MODEL_PATH=models/model.onnx
MODEL_URL=https://spring-ai-datasets.s3.eu-west-3.amazonaws.com/model.onnx
MODEL_DOWNLOAD_TIMEOUT_SECONDS=120
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLISHED_PORT=8000
API_TITLE=detectorLitter
API_VERSION=0.0.0
API_SUMMARY=Waste detection service from photos or satellite images
MAP_PUBLISHED_PORT=8502
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9090
DETECTION_DEFAULT_CONFIDENCE=60
DETECTION_NMS_SCORE_THRESHOLD=0.25
DETECTION_NMS_IOU_THRESHOLD=0.6
DEMO_ENDPOINT=https://detectorlitter.fly.dev
DEMO_TILE_ATTRIBUTION="<a target=\"_blank\" href=\"https://www.geoportail.gouv.fr/\">Geoportail France</a>"
DEMO_DEFAULT_LAT=48.755
DEMO_DEFAULT_LNG=2.245
DEMO_MAP_ZOOM=18
DEMO_MAP_MAX_NATIVE_ZOOM=19
DEMO_MAP_MAX_ZOOM=20
DEMO_COORDINATE_STEP=0.001
DEMO_COORDINATE_FORMAT=%.3f
DEMO_MAP_CONTROL_SCALE=true
DEMO_MAP_MAX_BOUNDS=true
DEMO_DEFAULT_CONFIDENCE=60
DEMO_HOST=0.0.0.0
DEMO_PORT=8501
DEMO_PUBLISHED_PORT=8501
PYTHON_VERSION=3.11-slim
