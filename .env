# Satellite tile provider
TILE_ENDPOINT="https://wxs.ign.fr/ortho/geoportail/wmts?layer=ORTHOIMAGERY.ORTHOPHOTOS&style=normal&tilematrixset=PM&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/jpeg&TileMatrix={z}&TileCol={x}&TileRow={y}"
# Satellite tile optimal zoom
TILE_ZOOM=18
# Max amount of tiles per search request
MAX_SEARCH_TILES=500

# detectorLitter endpoint for the demo
DEMO_ENDPOINT=http://localhost:8000
# Tile endpoint attribution
DEMO_TILE_ATTRIBUTION='<a target="_blank" href="https://www.geoportail.gouv.fr/">Geoportail France</a>'
